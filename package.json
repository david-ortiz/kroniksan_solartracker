{
  "name": "kroniksan-solartracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Solar monitoring dashboard for SolarEdge residential installs (Monitoring API v2).",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "typecheck": "tsc --noEmit -p web"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "echarts": "^6.1.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
