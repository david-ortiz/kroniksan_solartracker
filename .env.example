# --- SolarEdge (developer.solaredge.com → your app: Monitoring API, Site Access) ---
# Leave these empty to run in demo mode with simulated data.
SOLAREDGE_CLIENT_ID=
SOLAREDGE_CLIENT_SECRET=

# Where you open the dashboard. Register "<APP_URL>/auth/callback" in your
# SolarEdge app as BOTH the Redirect URI and the Returned URL.
APP_URL=http://localhost:8787
PORT=8787

# Optional: pin a site id (normally it comes back from the sign-in).
SOLAREDGE_SITE_ID=

# Credits. Free tier = 2,000/month, 10/minute. Keep some headroom.
SOLAREDGE_MONTHLY_BUDGET=1800
# Day of the month your credits reset (see Usage in the developer console).
SOLAREDGE_BILLING_DAY=1
# Days of detailed 15-minute curves to fetch right after connecting.
SOLAREDGE_INITIAL_POWER_DAYS=3

# --- Money and CO2 shown on the dashboard ---
CURRENCY=EUR
ENERGY_IMPORT_PRICE=0.30
ENERGY_EXPORT_PRICE=0.08
GRID_CO2_KG_PER_KWH=0.4

# Force the simulated demo even with credentials set.
DEMO=false
